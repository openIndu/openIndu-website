# ============================================================
# openIndu-website 开发环境配置模板
# 使用方法: cp .env.example .env
# 注意: .env 文件不会被 Git 跟踪
# ============================================================

# --- 数据库 ---
DATABASE_URL=postgresql://openindu:openindu123@postgres:5432/openindu_backend

# --- 存储后端 ---
# "local": 本地文件系统存储（开发环境默认）
# "s3":    S3 兼容存储（MinIO 开发 / 阿里云 OSS 生产）
STORAGE_BACKEND=local
DATA_DIR=/data/files

# --- S3 / OSS 凭证（仅 STORAGE_BACKEND=s3 时需要）---
OSS_ACCESS_KEY_ID=minioadmin
OSS_ACCESS_KEY_SECRET=minioadmin
OSS_ENDPOINT=http://minio:9000
OSS_BUCKET=openindu
OSS_REGION=us-east-1
# --- OSS 路径前缀 ---
OSS_DOC_PREFIX=doc
OSS_SOFTWARE_PREFIX=software
OSS_LEGACY_DOC_PREFIX=doc


# --- Milvus 向量数据库 ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=plc_knowledge

# --- JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 短信验证码（阿里云 dysmsapi）---
# SMS_MOCK_ENABLED=true 时忽略下方所有字段，验证码固定为 SMS_MOCK_CODE
SMS_ACCESS_KEY=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
# 短信模板 Code（如：SMS_123456789），模板变量为 {code}
SMS_TEMPLATE_ID=
SMS_MOCK_ENABLED=true
SMS_MOCK_CODE=888888

# --- MCP Server ---
MCP_API_KEY=change-me-mcp-key
WEB_PORT=8004
MCP_PORT=8005

# --- 下载限制 ---
DOWNLOAD_DAILY_LIMIT=5
PRESIGNED_URL_EXPIRE_MINUTES=5
DOCUMENT_MAX_SIZE_MB=50
SOFTWARE_MAX_SIZE_GB=5

# --- RAG 同步 ---
RAG_SYNC_INTERVAL_MINUTES=60
