# ============================================================
# openIndu-website 开发环境配置模板
# 使用方法: cp .env.example .env
# 注意: .env 文件不会被 Git 跟踪
# ============================================================

# --- 数据库 ---
DATABASE_URL=postgresql://openindu:openindu123@postgres:5432/openindu_backend

# --- 存储后端 ---
# "local": 本地文件系统存储（开发环境默认）
# "s3":    S3 兼容存储（MinIO 开发 / 阿里云 OSS 生产）
STORAGE_BACKEND=local
DATA_DIR=/data/files

# --- S3 / OSS 凭证（仅 STORAGE_BACKEND=s3 时需要）---
OSS_ACCESS_KEY_ID=minioadmin
OSS_ACCESS_KEY_SECRET=minioadmin
OSS_ENDPOINT=http://minio:9000
OSS_BUCKET=openindu
OSS_REGION=us-east-1
# --- OSS 路径前缀 ---
OSS_DOC_PREFIX=doc
OSS_SOFTWARE_PREFIX=soft
OSS_LEGACY_DOC_PREFIX=doc


# --- Milvus 向量数据库 ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
# 现网知识库 collection（含 mitsubishi/omron/fuji/siemens 等 16 个品牌共 14w+ chunks）。
# 若部署到全新 Milvus，需先用 scripts/offline_embed.py 灌库后再切到此名。
MILVUS_COLLECTION=controller_knowledge

# --- IP 地区解析（ip2region 离线 xdb）---
# 「登录地区」/ 访问地图按 IP 解析省市运营商。相对路径以后端根目录为基准，
# 数据文件已随后端仓提交在 openIndu-backend/data/ip2region_v4.xdb。
IP2REGION_XDB_PATH=data/ip2region_v4.xdb

# --- JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 短信验证码（阿里云 dysmsapi）---
# SMS_MOCK_ENABLED=true 时忽略下方所有字段，验证码固定为 SMS_MOCK_CODE
SMS_ACCESS_KEY=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
# 短信模板 Code（如：SMS_123456789），模板变量为 {code}
SMS_TEMPLATE_ID=
SMS_MOCK_ENABLED=true
SMS_MOCK_CODE=888888
SMS_MOCK_EXTRA_CODE=   # 附加测试验证码，用于区分不同测试账号；留空不生效

# --- MCP Server ---
MCP_API_KEY=change-me-mcp-key
WEB_PORT=8004
MCP_PORT=8005

# --- 下载限制 ---
DOWNLOAD_DAILY_LIMIT=5
PRESIGNED_URL_EXPIRE_MINUTES=5
DOCUMENT_MAX_SIZE_MB=50
SOFTWARE_MAX_SIZE_GB=5

# --- RAG 同步 ---
# RAG_SYNC_INTERVAL_MINUTES 仅在 RAG_SYNC_ENABLED=true 时生效。
# 默认关闭定时同步：BGE-M3 嵌入吃资源，绝大多数场景下点 admin UI 同步按钮
# 或跑 scripts/sync_local.py 更可控。改成 true 才会每 N 分钟自动同步。
RAG_SYNC_INTERVAL_MINUTES=60
RAG_SYNC_ENABLED=false

# --- 智能咨询 / RAG 对话（§4.3.12）---
# OpenAI 兼容客户端；切换厂商只需改 base_url + model + api_key。LLM_API_KEY 留空则
# /api/v1/chat 仍能跑通检索，但生成阶段会返回 error 帧（前端会展示降级提示）。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# 每次问答从 Milvus 取多少 chunk 作为上下文。
RAG_TOP_K=5
# 单 member 每日咨询次数上限；admin 角色豁免。
CHAT_DAILY_LIMIT=30
